# Copy this file to .env and fill in your own values.
# .env is git-ignored so secrets never leave your machine.

# Supabase public browser configuration for private articles.
# The anon key is safe to expose; Row Level Security protects the data.
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: cookie used by scripts/fetch-covers.ts to pull Pixiv ranking covers.
# Format: a single line copied from a logged-in browser session.
PIXIV_COOKIE=
